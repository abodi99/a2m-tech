# ──────────────────────────────────────────────
# A2M Tech – Environment variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────

# ── Umami Analytics (already running in Coolify as "umami volontera") ──
# Privacy-friendly analytics. No cookie consent required.
# Steps:
#   1. Open your Umami UI (Coolify → umami volontera → domain)
#   2. Settings → Websites → Add website → Domain: a2m-tech.com
#   3. Copy Website ID below
NEXT_PUBLIC_UMAMI_URL=https://umami.volontera.se
NEXT_PUBLIC_UMAMI_WEBSITE_ID=f7bf27e8-a993-43b9-9f33-aef1067f2758

# ── Google Analytics 4 via Firebase project a2m-tech-web ──
# Firebase project created: a2m-tech-web (project number 193089700902)
# Web app created: a2m-tech.com (1:193089700902:web:7575da97c707f2cc2992e7)
# Steps to get Measurement ID:
#   1. https://console.firebase.google.com/project/a2m-tech-web/settings/integrations
#   2. Enable Google Analytics → create/link a GA4 property for a2m-tech.com
#   3. Copy Measurement ID (G-XXXXXXXXXX) below
# When set, a GDPR cookie consent banner appears automatically.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Google Search Console ──
#   1. https://search.google.com/search-console
#   2. Add property → Domain: a2m-tech.com (DNS TXT) OR URL prefix
#   3. After verification, submit https://a2m-tech.com/sitemap.xml

# ── Listmonk (already running in Coolify) ──
# Newsletter form posts to /api/subscribe.php (CSV + admin email).
# Optional live sync: copy public/api/subscribe.config.example.php
# to public/api/subscribe.config.php on Hostinger with Listmonk API creds.

# ── Contact form ──
# Handler: public/api/contact.php → info@a2m-tech.com
# Newsletter: public/api/subscribe.php → CSV + optional Listmonk
